# Copy to .env.local for a machine-specific override. Do not put secrets here.
# Production intake stays off until the owner confirms staff review, deploys
# submitInquiry, and sets the matching INTAKE_* flags on the function.

# Approved public origin, no trailing slash. Unset keeps pages noindex and omits canonical URLs.
PUBLIC_SITE_URL=
# Set to true only for the production build that should be indexed.
PUBLIC_ALLOW_INDEX=

# Firebase web app config. Put real values in gitignored .env.production.
# Do not paste the api key into this example file.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=estaya
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1004630519922
PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# reCAPTCHA v3 site key for App Check. Not set. Required before production intake is shown.
PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Must stay unset in production. Local emulator use only.
PUBLIC_USE_FIREBASE_EMULATOR=

# Each flag must be the string true, and Firebase web config plus App Check must be present.
PUBLIC_INTAKE_SUPPLY_OFFER=
PUBLIC_INTAKE_PARTNER_INQUIRY=
PUBLIC_INTAKE_CONTACT=

# Verified public inbox. Leave empty until the owner confirms it.
PUBLIC_CONTACT_EMAIL=

# Financial giving stays off until status is reviewed. URL must be https.
# PUBLIC_DONATE_WORDING is the reviewed sentence shown beside the Donate link.
PUBLIC_DONATE_ENABLED=
PUBLIC_DONATE_URL=
PUBLIC_DONATE_WORDING=
