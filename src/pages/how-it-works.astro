---
import Base from "../layouts/Base.astro";
import { routes, steps } from "../config/site";

const meta = routes[2];
---

<Base title={meta.title} description={meta.description}>
  <section class="section intro">
    <div class="wrap">
      <h1>From surplus to supplies partners can use.</h1>
      <div class="rule" aria-hidden="true"></div>
      <ol class="steps">
        {steps.map(([title, copy], index) => (
          <li>
            <span class="step-no" aria-hidden="true">{index + 1}</span>
            <div class="prose">
              <h2>{title}</h2>
              <p>{copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section section-stone">
    <div class="wrap">
      <h2>Start a conversation</h2>
      <p class="prose">An inquiry does not confirm acceptance, pickup, eligibility, stock, or fulfillment.</p>
      <p>
        <a class="btn btn-teal" href="/give-supplies/#offer">Offer medical supplies</a>
      </p>
      <p>
        <a class="text-link" href="/for-nonprofits/#inquire">Tell us what you need</a>
      </p>
    </div>
  </section>
</Base>
