---
import { brandAssets, primaryNav } from "../config/site";

const current = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="wordmark" href="/" aria-label="Estaya home">
      {brandAssets.logoHorizontal ? <img src={brandAssets.logoHorizontal} alt="Estaya" height="32" /> : "ESTAYA"}
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span>
    </button>
    <nav id="site-nav" class="site-nav" data-nav aria-label="Primary">
      {primaryNav.map((item) => (
        <a href={item.href} aria-current={current === item.href ? "page" : undefined}>{item.label}</a>
      ))}
      <a class="nav-contact" href="/contact/" aria-current={current === "/contact/" ? "page" : undefined}>Contact</a>
    </nav>
  </div>
</header>
<script>
  import "../scripts/nav.ts";
</script>
